+# ---- Phase B rho-probe helpers (imposed per-region rigidity; item-2 Path A) ----
+def partition_anchors_by_handle(anchor, handle_xyz, rho_frac):
+    """D = nearest rho_frac to the handle (label 0); R = far remainder (label 1)."""
+    d = (anchor - handle_xyz[None]).norm(dim=1)
+    n_D = max(1, int(rho_frac * anchor.shape[0]))
+    label = torch.ones(anchor.shape[0], dtype=torch.long, device=anchor.device)
+    label[torch.argsort(d)[:n_D]] = 0
+    return label
+
+
+def rho_scale_weights(weight, indices_knn, region_label, rho, rigid_id=1):
+    """Post-scale row-normalised rbf weights by rho on R-R interior edges only.
+    rho==1 -> exact no-op. Do NOT renormalise (would cancel rho on interior-R rows)."""
+    if rho == 1.0:
+        return weight
+    i_R = (region_label == rigid_id)
+    rr = i_R[:, None] & i_R[indices_knn]
+    return weight * torch.where(rr, weight.new_tensor(float(rho)), weight.new_tensor(1.0))
